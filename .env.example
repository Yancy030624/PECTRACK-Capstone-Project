# Copy this file to .env and replace the placeholder with your local PostgreSQL password.
PORT=3001
# Origin the API accepts cross-origin requests (with cookies) from. Defaults
# to the Vite dev server if unset — only needed if that ever changes.
CLIENT_ORIGIN=http://localhost:5173
PGHOST=localhost
PGPORT=5432
PGDATABASE=pectrack
PGUSER=postgres
PGPASSWORD=1234
# Phase 6.5 — live PayMongo integration (see PHASE6.5_PLAN.md). Leave unset
# until you have real test-mode credentials; the app works fine without
# them, "Pay with GCash" just isn't reachable yet.
#
# Dashboard -> Developers -> API Keys (with the Test/Live switch set to
# Test) for PAYMONGO_SECRET_KEY -- starts sk_test_.
# Dashboard -> Developers -> Webhooks -> Add endpoint for
# PAYMONGO_WEBHOOK_SECRET -- shown once, at creation, starts whsk_. The
# endpoint URL only needs to be reachable once a tunnel is running.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Where PayMongo's hosted checkout page redirects the customer after they
# pay or cancel. This app has no client-side routing yet, so both point at
# the site root -- the redirect is UX only, never the source of truth for
# whether payment succeeded (the webhook is).
PAYMONGO_SUCCESS_URL=http://localhost:5173/
PAYMONGO_CANCEL_URL=http://localhost:5173/
